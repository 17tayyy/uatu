# Copy to .env and fill in. Free API key: https://aisstream.io (sign in with GitHub).
AISSTREAM_API_KEY=

# Postgres credentials used by docker compose. Keep the password URL-safe (letters and digits).
POSTGRES_USER=uatu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uatu
POSTGRES_PORT=5432

# Only used when running outside docker compose (uv run ...), which overrides it.
DATABASE_URL=postgresql+asyncpg://uatu:change-me@localhost:5432/uatu

# Optional, defaults shown.
# AIS_BBOX=35.5,-6.5,36.5,-4.5
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# RAW_ARCHIVE_DIR=./data/raw
