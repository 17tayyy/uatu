# Copy to .env and fill in. Free API key: https://aisstream.io (sign in with GitHub).
AISSTREAM_API_KEY=

# Copernicus Data Space Ecosystem account (https://dataspace.copernicus.eu), to download Sentinel-1.
CDSE_USERNAME=
CDSE_PASSWORD=

# Postgres credentials used by docker compose. Keep the password URL-safe (letters and digits).
POSTGRES_USER=uatu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uatu
POSTGRES_PORT=5432

# Only used when running outside docker compose (uv run ...), which overrides it.
DATABASE_URL=postgresql+asyncpg://uatu:change-me@localhost:5432/uatu

# Optional, defaults shown.
# AIS_BBOX=35.5,-6.5,36.5,-4.5
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# RAW_ARCHIVE_DIR=./data/raw
# SAR_BBOX=35.5,-6.5,36.5,-4.5
# SAR_DATA_DIR=./data/sar
# SAR_DISCOVER_MINUTES=10
# SAR_KEEP_SCENES=false
# REDIS_URL=redis://localhost:6379

# Alerts (optional). ntfy: install its app and subscribe to the topic; pick an unguessable one.
# NTFY_URL=https://ntfy.sh/uatu-<random>
# Dead man's switch (optional), alerts when the worker stops pinging, e.g. https://healthchecks.io
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
