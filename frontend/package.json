{
  "name": "uatu-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Uatu's dashboard: radar passes, AIS and their review, on one map.",
  "scripts": {
    "api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "npm run api && vite",
    "build": "npm run api && tsc --noEmit && vite build",
    "check": "npm run api && tsc --noEmit && biome check src && vitest run",
    "format": "biome check --write src"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "lucide-react": "1.57.0",
    "maplibre-gl": "6.13.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
